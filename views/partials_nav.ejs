<div class="floating-menu-wrap private-menu-wrap">
  <button class="kebab private-kebab" type="button" onclick="togglePrivateMenu()" aria-label="Buka menu">
    <span></span><span></span><span></span>
  </button>
  <div id="privateMenu" class="public-menu floating-public-menu hide">
    <% if(user && user.role === 'admin'){ %>
      <a href="/admin/dashboard">Dashboard</a>
      <a href="/admin/master">Master Data</a>
      <a href="/admin/users">Management User</a>
      <a href="/admin/iuran">Iuran IWK</a>
      <a href="/admin/kas">Transaksi Kas</a>
      <a href="/admin/laporan-keuangan">Laporan Keuangan</a>
      <a href="/admin/maintenance">Backup & Maintenance</a>
      <a href="/">Tampilan Umum</a>
    <% } else if(user && user.role === 'petugas'){ %>
      <a href="/petugas/dashboard">Input IWK</a>
      <a href="/">Tampilan Umum</a>
    <% } %>
    <% if(user){ %><a href="#" onclick="logout()">Logout</a><% } %>
    <small class="app-version-text menu-version">SIKERT</small>
  </div>
  <div class="app-version-text version-box">SIKERT</div>
</div>
<script>
async function logout(){await fetch('/api/auth/logout',{method:'POST'});location.href='/'}
function togglePrivateMenu(){ document.getElementById('privateMenu')?.classList.toggle('hide'); }
fetch('/api/info/version').then(r=>r.json()).then(d=>{document.querySelectorAll('.app-version-text').forEach(el=>el.textContent=`${d.name} v${d.version}`)}).catch(()=>{});
</script>
