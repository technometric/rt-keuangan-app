<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Input IWK</title><link rel="stylesheet" href="/css/style.css"></head><body><div class="app"><%- include('../partials_nav') %><main class="main"><div class="title">Input Pembayaran IWK</div><div class="sub">Area penagihan otomatis mengikuti akun petugas.</div><div class="panel"><form id="formIwk"><div class="row"><select class="select" name="warga" id="warga"></select><input class="input" name="nominal_bayar" type="number" placeholder="Nominal bayar"><select class="select" name="metode_bayar"><option value="cash">Cash</option><option value="transfer">Transfer</option></select></div><div class="row two"><input class="input" type="file" name="foto_bayar" accept="image/*" capture="environment"><textarea name="catatan_petugas" placeholder="Catatan jika belum bayar / bayar kurang"></textarea></div><button class="btn">Simpan Pembayaran</button></form><p id="msg" class="sub"></p></div><div class="panel"><h2>Riwayat IWK</h2><table><thead><tr><th>Tanggal</th><th>Warga</th><th>Nominal</th><th>Status</th><th>Catatan</th></tr></thead><tbody id="riwayat"></tbody></table></div></main></div><script src="/js/app.js"></script><script>initPetugasIwk()</script></body></html>
