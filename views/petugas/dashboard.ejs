<!doctype html>
<html>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>Input IWK</title>
  <link rel="stylesheet" href="/css/style.css?v=<%= assetVersion %>-v1315-santunan-actions">
</head>
<body>
  <div class="app">
    <%- include('../partials_nav') %>
    <main class="main">
      <div class="title">Input Pembayaran IWK</div>
      <div class="sub">Petugas bisa input pembayaran untuk semua wilayah dan beberapa bulan sekaligus.</div>

      <div class="tabbar payment-tabs">
        <button class="tab-btn active" type="button" data-tab="iwk" onclick="setPaymentTab('iwk')">IWK</button>
        <button class="tab-btn" type="button" data-tab="dana_santunan" onclick="setPaymentTab('dana_santunan')">Dana Santunan</button>
        <button class="tab-btn" type="button" data-tab="donasi" onclick="setPaymentTab('donasi')">Donasi</button>
      </div>

      <div id="iwkPaymentPanel" class="panel payment-panel">
        <form id="formIwk">
          <div class="row">
            <label class="field-label">Warga
              <input type="hidden" name="warga" id="warga" required>
              <div class="custom-warga-select" data-custom-warga="warga">
                <input class="input custom-warga-search" type="search" placeholder="Cari nama / no rumah / area" autocomplete="off">
                <div class="custom-warga-options"></div>
              </div>
            </label>
            <label class="field-label">Nominal Total Bayar<input class="input" name="nominal_bayar" id="nominalBayar" type="number" placeholder="Nominal total bayar"></label>
            <label class="field-label">Metode Bayar<select class="select" name="metode_bayar"><option value="cash">Cash</option><option value="transfer">Transfer</option></select></label>
          </div>
          <div class="row">
            <label class="field-label">Tahun<input class="input" name="tahun" id="tahunMulai" type="number" placeholder="Tahun"></label>
            <label class="field-label month-check-field">Bulan Dibayar<div id="bulanChecklist" class="month-check-grid"></div></label>
          </div>
          <div class="row two">
            <label id="fotoIwkInputWrap" class="field-label">Foto Bayar<input class="input" type="file" name="foto_bayar" accept="image/*" capture="environment"></label>
            <label class="field-label">Catatan Petugas<textarea name="catatan_petugas" placeholder="Catatan jika belum bayar / bayar kurang"></textarea></label>
          </div>
          <button class="btn">Simpan Pembayaran</button>
        </form>
        <p id="msg" class="sub"></p>
      </div>

      <div id="danaSantunanPaymentPanel" class="panel payment-panel hide">
        <form id="formDanaSantunan">
          <div class="row">
            <label class="field-label">Warga Anggota Dana Santunan
              <input type="hidden" name="warga" id="santunanWarga" required>
              <div class="custom-warga-select" data-custom-warga="santunanWarga">
                <input class="input custom-warga-search" type="search" placeholder="Cari anggota Dana Santunan" autocomplete="off">
                <div class="custom-warga-options"></div>
              </div>
            </label>
            <label class="field-label">Nominal Total<input class="input" name="nominal" id="santunanNominal" type="number" min="1" placeholder="Nominal Dana Santunan"></label>
          </div>
          <div class="row">
            <label class="field-label">Tahun<input class="input" name="tahun" id="santunanTahun" type="number" placeholder="Tahun"></label>
            <label class="field-label month-check-field">Bulan Dibayar<div id="santunanBulanChecklist" class="month-check-grid"></div></label>
          </div>
          <button class="btn">Simpan Dana Santunan</button>
        </form>
        <p id="santunanMsg" class="sub"></p>
        <div class="table-wrap">
          <table>
            <thead><tr><th>Tanggal</th><th>Keterangan</th><th>Nominal</th><th>Petugas</th><th>Aksi</th></tr></thead>
            <tbody id="santunanRows"></tbody>
          </table>
        </div>
      </div>

      <div id="donasiPaymentPanel" class="panel payment-panel hide">
        <form id="formDonasi">
          <div class="row">
            <label class="field-label">Tanggal<input class="input" name="tanggal" type="datetime-local"></label>
            <label class="field-label">Nama Warga<input class="input" name="nama" placeholder="Nama penyumbang" required></label>
            <label class="field-label">Nomor Rumah<input class="input" name="no_rumah" placeholder="No rumah" required></label>
          </div>
          <div class="row">
            <label class="field-label">Nominal Donasi<input class="input" name="nominal" type="number" min="1" placeholder="Nominal donasi" required></label>
          </div>
          <button class="btn">Simpan Donasi</button>
        </form>
        <p id="donasiMsg" class="sub"></p>
      </div>

      <div id="petugasIwkTotalBulanIni" class="iwk-progress-card"></div>

      <div id="riwayatIwkInputPanel" class="panel">
        <div class="table-toolbar">
          <div>
            <h2 id="riwayatPanelTitle">Riwayat IWK</h2>
            <p id="riwayatPanelDesc" class="sub">Bisa dicetak PDF sebagai bukti penagihan ke bendahara.</p>
          </div>
          <div class="toolbar-actions">
            <label class="field-label compact-field">Bulan
              <select id="riwayatBulan" class="select mini-select"></select>
            </label>
            <label class="field-label compact-field">Tahun
              <input id="riwayatTahun" class="input mini-input" type="number">
            </label>
            <label class="field-label compact-field search-field">Cari
              <input id="riwayatSearch" class="input mini-input" type="search" placeholder="Nama / rumah / catatan" autocomplete="off">
            </label>
            <button class="btn secondary" type="button" onclick="printRiwayatPetugas()">Print/Share PDF</button>
          </div>
        </div>
        <div class="table-wrap">
          <table>
            <thead><tr><th>Tanggal</th><th>Warga</th><th>Nominal</th><th>Status</th><th>Catatan</th><th>Aksi</th></tr></thead>
            <tbody id="riwayat" data-actions="delete" data-info="catatan"></tbody>
          </table>
        </div>
      </div>
    </main>
  </div>
  <script src="/js/app.js?v=<%= assetVersion %>-v1315-santunan-actions"></script>
  <script>initPetugasIwk()</script>
</body>
</html>
