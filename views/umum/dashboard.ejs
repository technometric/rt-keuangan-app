<!doctype html>
<html lang="id">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1">
  <title>Informasi Keuangan RT02</title>
  <link rel="stylesheet" href="/css/style.css?v=<%= assetVersion %>-bukti-iwk-checks">
</head>
<body class="public-body clean-public">
  <div class="floating-menu-wrap">
    <button class="kebab floating-kebab" type="button" onclick="togglePublicMenu()" aria-label="Buka menu">
      <span></span><span></span><span></span>
    </button>
    <div id="publicMenu" class="public-menu floating-public-menu hide">
      <a href="#" onclick="logoutPublic()">Logout Warga</a>
    </div>
  </div>

  <main class="public-main">
    <section class="hero-card rt02-hero no-badge">
      <div>
        <p class="eyebrow">Informasi Keuangan Warga RT02</p>
        <h1>Keuangan RT02<% if (publicWarga?.no_rumah) { %> - <%= publicWarga.no_rumah %><% } %></h1>
        <p class="hero-desc">Ringkasan kas utama dan status pembayaran IWK warga secara transparan.</p>
      </div>
    </section>

    <section>
      <div class="section-head">
        <div>
          <h2>Informasi Keuangan</h2>
          <p>Pos kas yang ditampilkan untuk umum.</p>
        </div>
      </div>
      <div id="saldoGrid" class="public-grid"></div>
      <div id="pengeluaranModal" class="iwk-status-modal hide"></div>
      <div id="donasiModal" class="iwk-status-modal hide"></div>
      <div id="iwkProgressCard" class="iwk-progress-card"></div>
      <div id="rekeningIwkCard" class="transfer-info-card hide"></div>
    </section>

    <section class="public-panel">
      <div class="section-head compact year-head">
        <div>
          <h2>Status Pembayaran IWK</h2>
          <p id="iwkStatusNote">Kartu mengikuti status pembayaran IWK bulan berjalan.</p>
        </div>
        <div class="year-control stacked-control">
          <select id="iwkStatusBulan" class="select mini-select" onchange="loadIwkYear()"></select>
          <input id="iwkStatusTahun" class="input mini-input" type="number" onchange="loadIwkYear()">
          <strong id="iwkYearText"></strong>
        </div>
      </div>

      <div id="statusFilterWrap" class="status-filter">
        <button class="filter-pill green" data-status="bayar" onclick="setIwkFilter('bayar', this)">Bayar</button>
        <button class="filter-pill orange" data-status="kurang" onclick="setIwkFilter('kurang', this)">Kurang</button>
        <button class="filter-pill red active" data-status="belum_bayar" onclick="setIwkFilter('belum_bayar', this)">Blm Bayar</button>
        <button class="filter-pill" data-status="semua" onclick="setIwkFilter('semua', this)">Semua</button>
      </div>

      <div class="legend-row">
        <span><i class="dot green hollow"></i>Bayar</span>
        <span><i class="dot orange hollow"></i>Kurang</span>
        <span><i class="dot red hollow"></i>Blm bayar</span>
      </div>

      <div id="iwkYearGrid" class="iwk-year-grid"></div>
      <div id="iwkStatusModal" class="iwk-status-modal hide"></div>
    </section>

    <section id="tunggakanSebelumnyaSection" class="public-panel hide">
      <div class="section-head compact">
        <div>
          <h2 id="tunggakanSebelumnyaTitle">Tunggakan IWK</h2>
          <p>Daftar ini tampil jika diaktifkan dari master data.</p>
        </div>
      </div>
      <div class="report-table-wrap">
        <table class="report-table compact-table">
          <thead><tr><th>No</th><th>Nama</th><th>No Rumah</th><th>Area</th></tr></thead>
          <tbody id="tunggakanSebelumnyaRows"></tbody>
        </table>
      </div>
    </section>
  </main>

  <footer class="public-footer">Aplikasi Keuangan RT02 · <span class="app-version-text">SIKERT</span></footer>

  <script>
    window.PUBLIC_DASHBOARD = <%= publicMode ? 'true' : 'false' %>;
    window.PUBLIC_WARGA_ID = <%- JSON.stringify(publicWarga?.id || '') %>;
    window.PUBLIC_WARGA_NO_RUMAH = <%- JSON.stringify(publicWarga?.no_rumah || '') %>;
  </script>
  <script src="/js/app.js?v=<%= assetVersion %>-bukti-iwk-checks"></script>
  <script>
    async function logoutPublic(){ await fetch('/api/auth/public-logout',{method:'POST'}); location.href='/umum/login'; }
    loadSaldo();loadIwkProgress();if(typeof loadRekeningIwk === 'function') loadRekeningIwk();initIwkYearView();loadTunggakanSebelumnya();loadAppVersion();
  </script>
</body>
</html>
