<!doctype html>
<html lang="id">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1">
  <title>Informasi Keuangan RT02</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="public-body clean-public">
  <div class="floating-menu-wrap">
    <button class="kebab floating-kebab" type="button" onclick="togglePublicMenu()" aria-label="Buka menu">
      <span></span><span></span><span></span>
    </button>
    <div id="publicMenu" class="public-menu floating-public-menu hide">
      <a href="/login?next=/petugas/dashboard">Login Petugas</a>
    </div>
  </div>

  <main class="public-main">
    <section class="hero-card rt02-hero no-badge">
      <div>
        <p class="eyebrow">Informasi Keuangan Warga RT02</p>
        <h1>Keuangan RT02</h1>
        <p class="hero-desc">Ringkasan kas utama dan status pembayaran IWK warga secara transparan.</p>
      </div>
    </section>

    <section>
      <div class="section-head">
        <div>
          <h2>Informasi Keuangan</h2>
          <p>Pos kas yang ditampilkan untuk umum.</p>
        </div>
      </div>
      <div id="saldoGrid" class="public-grid"></div>
    </section>

    <section class="public-panel">
      <div class="section-head compact year-head">
        <div>
          <h2>Status Pembayaran IWK</h2>
          <p>Default menampilkan warga yang belum bayar.</p>
        </div>
        <div class="year-control stacked-control">
          <select id="iwkPeriodMode" class="select mini-select" onchange="setIwkPeriodMode(this.value)">
            <option value="all">All 1 Tahun</option>
            <option value="1">Januari</option><option value="2">Februari</option><option value="3">Maret</option><option value="4">April</option>
            <option value="5">Mei</option><option value="6">Juni</option><option value="7">Juli</option><option value="8">Agustus</option>
            <option value="9">September</option><option value="10">Oktober</option><option value="11">November</option><option value="12">Desember</option>
          </select>
          <strong id="iwkYearText"></strong>
        </div>
      </div>

      <div class="status-filter">
        <button class="filter-pill green" data-status="bayar" onclick="setIwkFilter('bayar', this)">Bayar</button>
        <button class="filter-pill orange" data-status="kurang" onclick="setIwkFilter('kurang', this)">Kurang</button>
        <button class="filter-pill red active" data-status="belum_bayar" onclick="setIwkFilter('belum_bayar', this)">Blm Bayar</button>
        <button class="filter-pill" data-status="semua" onclick="setIwkFilter('semua', this)">Semua</button>
      </div>

      <div class="legend-row">
        <span><i class="dot green hollow"></i>Bayar</span>
        <span><i class="dot orange hollow"></i>Kurang</span>
        <span><i class="dot red hollow"></i>Blm bayar</span>
      </div>

      <div id="iwkYearGrid" class="iwk-year-grid"></div>
    </section>
  </main>

  <footer class="public-footer">Aplikasi Keuangan RT02</footer>

  <script>
    window.PUBLIC_DASHBOARD = <%= publicMode ? 'true' : 'false' %>;
    window.PUBLIC_SALDO_KEYS = ['kas_rt','kas_sosial','kas_donasi','tabungan_sampah','santunan_kematian','danus'];
  </script>
  <script src="/js/app.js"></script>
  <script>loadSaldo();initIwkYearView();</script>
</body>
</html>
