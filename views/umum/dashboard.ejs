<!doctype html>
<html lang="id">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1">
  <title>Informasi Keuangan RT02</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="public-body clean-public">
  <div class="floating-menu-wrap">
    <button class="hamburger floating-hamburger" type="button" onclick="togglePublicMenu()" aria-label="Buka menu">
      <span></span><span></span><span></span>
    </button>
    <div id="publicMenu" class="public-menu floating-public-menu hide">
      <a href="/login?next=/petugas/dashboard">Login Petugas</a>
      <a href="/login?next=/admin/dashboard">Login Admin</a>
    </div>
  </div>

  <main class="public-main">
    <section class="hero-card rt02-hero">
      <div class="rt-badge big">RT02</div>
      <div>
        <p class="eyebrow">Informasi Keuangan Warga</p>
        <h1>Keuangan RT02</h1>
        <p class="hero-desc">Ringkasan kas utama dan status pembayaran IWK warga secara transparan.</p>
      </div>
    </section>

    <section>
      <div class="section-head">
        <div>
          <h2>Informasi Keuangan</h2>
          <p>Pos kas yang ditampilkan untuk umum.</p>
        </div>
      </div>
      <div id="saldoGrid" class="public-grid"></div>
    </section>

    <section class="public-panel">
      <div class="section-head compact year-head">
        <div>
          <h2>Status Pembayaran IWK 1 Tahun</h2>
          <p>Mode ringkas dengan warna per bulan.</p>
        </div>
        <div class="year-control">
          <button class="mini-btn" onclick="changeIwkYear(-1)">‹</button>
          <strong id="iwkYearText"></strong>
          <button class="mini-btn" onclick="changeIwkYear(1)">›</button>
        </div>
      </div>

      <div class="status-filter">
        <button class="filter-pill active" data-status="semua" onclick="setIwkFilter('semua', this)">Semua</button>
        <button class="filter-pill green" data-status="lunas" onclick="setIwkFilter('lunas', this)">Lunas</button>
        <button class="filter-pill orange" data-status="kurang" onclick="setIwkFilter('kurang', this)">Kurang</button>
        <button class="filter-pill red" data-status="belum_bayar" onclick="setIwkFilter('belum_bayar', this)">Belum Lunas</button>
      </div>

      <div class="legend-row">
        <span><i class="dot green"></i>Lunas</span>
        <span><i class="dot orange"></i>Kurang</span>
        <span><i class="dot red"></i>Belum lunas</span>
      </div>

      <div id="iwkYearGrid" class="iwk-year-grid"></div>
    </section>
  </main>

  <footer class="public-footer">Aplikasi Keuangan RT02</footer>

  <script>
    window.PUBLIC_DASHBOARD = <%= publicMode ? 'true' : 'false' %>;
    window.PUBLIC_SALDO_KEYS = ['kas_rt','kas_sosial','kas_donasi','tabungan_sampah','santunan_kematian','danus'];
  </script>
  <script src="/js/app.js"></script>
  <script>loadSaldo();initIwkYearView();</script>
</body>
</html>
