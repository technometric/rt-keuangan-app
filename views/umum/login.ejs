<!doctype html>
<html lang="id">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>Login Warga</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="login-wrap">
    <div class="login-card">
      <div class="brand">SIKERT<span>.</span></div>
      <div class="sub">Masuk halaman umum dengan nomor rumah. Username dan password sama, contoh K2.31.</div>
      <input id="username" class="input" placeholder="Nomor rumah">
      <input id="password" type="password" class="input" placeholder="Ulangi nomor rumah">
      <button class="btn full" onclick="loginPublic()">Masuk Halaman Umum</button>
      <p id="msg" class="sub"></p>
      <div style="margin-top:14px"><a href="/login?next=/petugas/dashboard" class="sub">Login petugas / admin</a></div>
    </div>
  </div>
  <script>
    const nextUrl = '<%= next || "/" %>';
    async function loginPublic(){
      const r = await fetch('/api/auth/public-login', {
        method: 'POST',
        headers: {'Content-Type':'application/json'},
        body: JSON.stringify({ username: username.value, password: password.value })
      });
      const d = await r.json();
      if(!r.ok){ msg.textContent = d.message || 'Login gagal'; return; }
      location.href = nextUrl || d.redirect || '/';
    }
  </script>
</body>
</html>
