<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Master Data</title><link rel="stylesheet" href="/css/style.css"></head><body><div class="app"><%- include('../partials_nav') %><main class="main"><div class="title">Master Data & Parameter IWK</div><div class="panel"><h2>Parameter IWK</h2><form id="formParam"><div class="row"><input class="input" name="uang_satpam" placeholder="Uang Satpam"><input class="input" name="uang_sampah" placeholder="Uang Sampah"><input class="input" name="kas_rw" placeholder="Kas RW"></div><div class="row"><input class="input" name="kas_rt" placeholder="Kas RT"><input class="input" name="kas_sosial" placeholder="Kas Sosial"><input class="input" name="santunan_kematian" placeholder="Santunan Kematian"></div><label><input type="checkbox" name="wajib_foto_cash"> Wajib foto saat cash</label><br><br><button class="btn">Simpan Parameter</button></form></div><div class="panel"><h2>Tambah Warga Wajib IWK</h2><form id="formWarga"><div class="row"><input class="input" name="nama" placeholder="Nama"><input class="input" name="nik" placeholder="NIK"><input class="input" name="hp" placeholder="HP"></div><div class="row"><input class="input" name="no_rumah" placeholder="No Rumah"><select class="select" name="area"><option value="utara">Utara</option><option value="tengah">Tengah</option><option value="selatan">Selatan</option></select><button class="btn">Tambah Warga</button></div></form></div><div class="panel"><table><thead><tr><th>Nama</th><th>No Rumah</th><th>Area</th><th>HP</th></tr></thead><tbody id="wargaRows"></tbody></table></div></main></div><script src="/js/app.js"></script><script>initMaster()</script></body></html>
