<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Management User</title><link rel="stylesheet" href="/css/style.css"></head><body><div class="app"><%- include('../partials_nav') %><main class="main"><div class="title">Management User</div><div class="sub">Kelola akun admin, petugas area, dan umum.</div><div class="panel"><form id="formUser"><input type="hidden" name="id" id="userId"><div class="row"><input class="input" name="nama" placeholder="Nama" required><input class="input" name="username" placeholder="Username" required><input class="input" name="password" type="password" placeholder="Password baru"></div><div class="row"><input class="input" name="jabatan" placeholder="Jabatan"><select class="select" name="role" id="role"><option value="admin">Admin</option><option value="petugas">Petugas</option><option value="umum">Umum</option></select><div id="areaWrap" class="hide"><select class="select" name="area"><option value="utara">Utara</option><option value="tengah">Tengah</option><option value="selatan">Selatan</option></select></div></div><label><input type="checkbox" name="aktif" checked> User aktif</label><br><br><div class="actions"><button class="btn">Simpan User</button><button type="button" class="btn orange" onclick="formUser.reset();userId.value='';formUser.aktif.checked=true">Reset Form</button></div></form></div><div class="panel table-scroll"><table><thead><tr><th>Nama</th><th>Username</th><th>Role</th><th>Area</th><th>Status</th><th>Aksi</th></tr></thead><tbody id="userRows"></tbody></table></div></main></div><script src="/js/app.js"></script><script>initUsers()</script></body></html>
