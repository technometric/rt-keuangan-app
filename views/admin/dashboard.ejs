<!doctype html>
<html>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>Dashboard Admin</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="app">
    <%- include('../partials_nav') %>
    <main class="main">
      <div class="topbar">
        <div>
          <div class="title">Dashboard Admin</div>
          <div class="sub">Ringkasan saldo semua pos keuangan</div>
        </div>
        <div class="actions">
          <a class="btn orange" href="/api/export/laporan-bulanan/pdf">Export PDF</a>
          <button class="btn" onclick="window.print()">Print / PNG</button>
        </div>
      </div>

      <div id="saldoGrid" class="grid"></div>
      <div id="iwkProgressCard" class="iwk-progress-card admin-progress"></div>

      <div class="panel">
        <div class="table-toolbar">
          <div>
            <h2>Laporan Bulanan Pemasukan IWK</h2>
            <p class="sub">Data dari input admin/petugas. Setoran ke Kas RT tetap dicatat manual saat bendahara menerima uang.</p>
          </div>
          <div class="toolbar-actions">
            <select id="adminIwkReportBulan" class="select mini-select"></select>
            <input id="adminIwkReportTahun" class="input mini-input" type="number">
            <button class="btn" type="button" onclick="loadAdminIwkMonthlyReport()">Tampilkan</button>
            <button class="btn orange" type="button" onclick="downloadAdminIwkMonthlyPdf()">Export PDF</button>
          </div>
        </div>
        <div id="adminIwkMonthlySummary" class="summary-grid"></div>
        <div class="table-scroll">
          <table>
            <thead><tr><th>Tanggal</th><th>Warga</th><th>No Rumah</th><th>Petugas</th><th>Status</th><th>Nominal</th></tr></thead>
            <tbody id="adminIwkMonthlyRows"></tbody>
          </table>
        </div>
      </div>

      <div class="panel">
        <div class="topbar" style="margin-bottom:0">
          <div>
            <h2 style="margin:0">Audit Trail</h2>
            <div class="sub">Khusus admin. Data audit otomatis expire setelah 2 bulan.</div>
          </div>
          <button class="btn" onclick="toggleAudit()">Hide / Show</button>
        </div>
        <div id="auditWrap" class="table-scroll hide">
          <table>
            <thead><tr><th>Waktu</th><th>User</th><th>Aksi</th><th>Modul</th><th>Detail</th></tr></thead>
            <tbody id="auditRows"></tbody>
          </table>
        </div>
      </div>
    </main>
  </div>
  <script src="/js/app.js"></script>
  <script>loadSaldo();loadIwkProgress();initAdminIwkMonthlyReport();loadAudit()</script>
</body>
</html>
