<!doctype html>
<html>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>Iuran IWK</title>
  <link rel="stylesheet" href="/css/style.css?v=<%= assetVersion %>-v1315-santunan-actions">
</head>
<body>
  <div class="app">
    <%- include('../partials_nav') %>
    <main class="main">
      <div class="title">Iuran Wajib IWK</div>

      <div class="panel">
        <h2>Setting Tampilan Status IWK</h2>
        <label class="check-pill inline-check">
          <input id="settingTunggakanIwkLama" type="checkbox">
          Tampilkan tunggakan IWK 12 bulan sebelumnya pada status pembayaran umum
        </label>
        <p id="settingTunggakanIwkLamaMsg" class="sub">Jika aktif, kartu merah di web umum bisa berarti belum bayar bulan berjalan atau ada tunggakan lama.</p>
        <label class="check-pill inline-check">
          <input id="settingRiwayatIwkInput" type="checkbox">
          Tampilkan riwayat IWK pada halaman input pembayaran
        </label>
        <p id="settingRiwayatIwkInputMsg" class="sub">Jika nonaktif, panel riwayat di halaman input admin dan petugas disembunyikan.</p>
        <label class="check-pill inline-check">
          <input id="settingFotoIwkInput" type="checkbox">
          Tampilkan input foto pada halaman input pembayaran IWK
        </label>
        <p id="settingFotoIwkInputMsg" class="sub">Jika nonaktif, kolom upload foto di halaman input admin dan petugas disembunyikan.</p>
        <label class="check-pill inline-check">
          <input id="settingValidasiCatatanTransfer" type="checkbox">
          Validasi catatan transfer wajib memuat nomor rumah
        </label>
        <p id="settingValidasiCatatanTransferMsg" class="sub">Jika aktif, bukti transfer warga hanya bisa dikirim jika catatan transfer terbaca berisi nomor rumah login.</p>
        <label class="field-label inline-setting">Tampilan Status IWK Web Umum
          <select id="settingStatusIwkUmum" class="select mini-select">
            <option value="belum_bayar">Belum Bayar</option>
            <option value="bayar">Bayar</option>
            <option value="kurang">Kurang</option>
            <option value="semua">Semua</option>
          </select>
        </label>
        <p id="settingStatusIwkUmumMsg" class="sub">Jika memilih Semua, tombol pilihan status di web umum disembunyikan.</p>
      </div>

      <div class="tabbar payment-tabs">
        <button class="tab-btn active" type="button" data-tab="iwk" onclick="setPaymentTab('iwk')">IWK</button>
        <button class="tab-btn" type="button" data-tab="dana_santunan" onclick="setPaymentTab('dana_santunan')">Dana Santunan</button>
        <button class="tab-btn" type="button" data-tab="donasi" onclick="setPaymentTab('donasi')">Donasi</button>
      </div>

      <div id="iwkPaymentPanel" class="panel payment-panel">
        <form id="formIwk">
          <div class="row">
            <label class="field-label">Warga
              <input type="hidden" name="warga" id="warga" required>
              <div class="custom-warga-select" data-custom-warga="warga">
                <input class="input custom-warga-search" type="search" placeholder="Cari nama / no rumah / area" autocomplete="off">
                <div class="custom-warga-options"></div>
              </div>
            </label>
            <label class="field-label">Nominal Total Bayar<input class="input" name="nominal_bayar" id="nominalBayar" type="number" placeholder="Nominal total bayar"></label>
            <label class="field-label">Metode Bayar<select class="select" name="metode_bayar"><option value="cash">Cash</option><option value="transfer">Transfer</option></select></label>
          </div>
          <div class="row">
            <label class="field-label">Tahun<input class="input" name="tahun" id="tahunMulai" type="number" placeholder="Tahun"></label>
            <label class="field-label month-check-field">Bulan Dibayar<div id="bulanChecklist" class="month-check-grid"></div></label>
          </div>
          <div class="row two">
            <label id="fotoIwkInputWrap" class="field-label">Foto Bayar<input class="input" type="file" name="foto_bayar" accept="image/*"></label>
            <label class="field-label">Catatan Petugas<textarea name="catatan_petugas" placeholder="Catatan jika belum bayar / bayar kurang"></textarea></label>
          </div>
          <button class="btn">Simpan</button>
        </form>
        <p id="msg" class="sub"></p>
      </div>

      <div id="danaSantunanPaymentPanel" class="panel payment-panel hide">
        <form id="formDanaSantunan">
          <div class="row">
            <label class="field-label">Warga Anggota Dana Santunan
              <input type="hidden" name="warga" id="santunanWarga" required>
              <div class="custom-warga-select" data-custom-warga="santunanWarga">
                <input class="input custom-warga-search" type="search" placeholder="Cari anggota Dana Santunan" autocomplete="off">
                <div class="custom-warga-options"></div>
              </div>
            </label>
            <label class="field-label">Nominal Total<input class="input" name="nominal" id="santunanNominal" type="number" min="1" placeholder="Nominal Dana Santunan"></label>
          </div>
          <div class="row">
            <label class="field-label">Tahun<input class="input" name="tahun" id="santunanTahun" type="number" placeholder="Tahun"></label>
            <label class="field-label month-check-field">Bulan Dibayar<div id="santunanBulanChecklist" class="month-check-grid"></div></label>
          </div>
          <button class="btn">Simpan Dana Santunan</button>
        </form>
        <p id="santunanMsg" class="sub"></p>
        <div class="table-wrap">
          <table>
            <thead><tr><th>Tanggal</th><th>Keterangan</th><th>Nominal</th><th>Petugas</th><th>Aksi</th></tr></thead>
            <tbody id="santunanRows"></tbody>
          </table>
        </div>
      </div>

      <div id="donasiPaymentPanel" class="panel payment-panel hide">
        <form id="formDonasi">
          <div class="row">
            <label class="field-label">Tanggal<input class="input" name="tanggal" type="datetime-local"></label>
            <label class="field-label">Nama Warga<input class="input" name="nama" placeholder="Nama penyumbang" required></label>
            <label class="field-label">Nomor Rumah<input class="input" name="no_rumah" placeholder="No rumah" required></label>
          </div>
          <div class="row">
            <label class="field-label">Nominal Donasi<input class="input" name="nominal" type="number" min="1" placeholder="Nominal donasi" required></label>
          </div>
          <button class="btn">Simpan Donasi</button>
        </form>
        <p id="donasiMsg" class="sub"></p>
      </div>

      <div class="panel">
        <div class="table-toolbar">
          <div>
            <h2>Pendapatan IWK Bulan Lalu</h2>
            <p class="sub">Pilih bulan untuk melihat status pendapatan dan cetak status warga per bulan.</p>
          </div>
          <div class="toolbar-actions">
            <label class="field-label compact-field">Bulan
              <select id="iwkStatusBulanLalu" class="select mini-select"></select>
            </label>
            <label class="field-label compact-field">Tahun
              <input id="iwkStatusTahunLalu" class="input mini-input" type="number">
            </label>
            <button class="btn orange" type="button" onclick="printIwkStatusBulananPdf()">Print PDF</button>
          </div>
        </div>
        <div id="iwkProgressBulanSebelumnya" class="iwk-progress-card admin-progress"></div>
      </div>

      <div class="panel">
        <h2>Tunggakan IWK 12 Bulan Sebelumnya</h2>
        <form id="formTunggakanIwk">
          <div class="row">
            <label class="field-label">Warga
              <input type="hidden" name="warga" id="tunggakanWarga" required>
              <div class="custom-warga-select" data-custom-warga="tunggakanWarga">
                <input class="input custom-warga-search" type="search" placeholder="Cari warga untuk setting tunggakan" autocomplete="off">
                <div class="custom-warga-options"></div>
              </div>
            </label>
          </div>
          <div id="tunggakanLegacyChecklist" class="month-check-grid legacy-grid"></div>
          <div class="actions"><button class="btn" type="submit">Simpan Tunggakan</button></div>
        </form>
        <p id="tunggakanLegacyMsg" class="sub">Centang bulan lama yang masih belum bayar agar status warga tetap merah.</p>
      </div>

      <div id="riwayatIwkInputPanel" class="panel">
        <div class="table-toolbar">
          <div>
            <h2 id="riwayatPanelTitle">Riwayat IWK</h2>
            <p id="riwayatPanelDesc" class="sub">Filter bulan/tahun atau cari baris yang akan dihapus.</p>
          </div>
          <div class="toolbar-actions">
            <label class="field-label compact-field">Bulan
              <select id="riwayatBulan" class="select mini-select"></select>
            </label>
            <label class="field-label compact-field">Tahun
              <input id="riwayatTahun" class="input mini-input" type="number">
            </label>
            <label class="field-label compact-field search-field">Cari
              <input id="riwayatSearch" class="input mini-input" type="search" placeholder="Nama / rumah / petugas" autocomplete="off">
            </label>
          </div>
        </div>
        <div class="table-wrap">
          <table>
            <thead><tr><th>No</th><th>Tanggal</th><th>Warga</th><th>Nominal</th><th>Status</th><th>Petugas</th><th>Aksi</th></tr></thead>
            <tbody id="riwayat" data-actions="delete" data-info="petugas"></tbody>
          </table>
        </div>
      </div>
    </main>
  </div>
  <script src="/js/app.js?v=<%= assetVersion %>-v1319-iwk-detail-total"></script>
  <script>initPetugasIwk();initIwkLegacySetting();initTunggakanIwkForm();setupIwkStatusBulanLalu();loadIwkProgressBulanSebelumnya();</script>
</body>
</html>
