<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Login SIKERT</title><link rel="stylesheet" href="/css/style.css"></head><body>
<div class="login-wrap"><div class="login-card"><div class="brand">SIKERT<span>.</span></div><div class="sub">Sistem Keuangan RT — rapi, cepat, dan transparan.</div><input id="username" class="input" placeholder="Username"><input id="password" type="password" class="input" placeholder="Password"><button class="btn full" onclick="login()">Masuk</button><p id="msg" class="sub"></p><div style="margin-top:14px"><a href="/" class="sub">← Kembali ke halaman umum</a></div></div></div>
<script>
const nextUrl = '<%= next || "" %>';
async function login(){
  const r=await fetch('/api/auth/login',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({username:username.value,password:password.value})});
  const d=await r.json();
  if(!r.ok){msg.textContent=d.message;return}
  if(nextUrl) return location.href=nextUrl;
  if(d.user.role==='admin') return location.href='/admin';
  if(d.user.role==='petugas') return location.href='/petugas';
  location.href='/';
}
</script>
</body></html>
